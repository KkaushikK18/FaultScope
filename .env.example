# Database Configuration
DATABASE_URL=postgresql://faultscope:faultscope_password@localhost:5432/faultscope_db

# Application Configuration
APP_NAME=FaultScope
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_V1_PREFIX=/api/v1

# ML Configuration
MIN_TRAINING_SAMPLES=100
MODEL_PATH=models/

# Anomaly Detection - Rule-Based Thresholds
RULE_CPU_THRESHOLD=80.0
RULE_MEMORY_THRESHOLD=85.0
RULE_ERROR_RATE_THRESHOLD=10.0
RULE_LATENCY_THRESHOLD=2000.0

# Anomaly Detection - Isolation Forest
ISOLATION_FOREST_CONTAMINATION=0.1
ISOLATION_FOREST_N_ESTIMATORS=100
ISOLATION_FOREST_RANDOM_STATE=42

# Incident Severity Thresholds
SEVERITY_CRITICAL_SCORE=0.9
SEVERITY_HIGH_SCORE=0.75
SEVERITY_MEDIUM_SCORE=0.5
